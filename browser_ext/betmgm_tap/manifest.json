{
  "manifest_version": 3,
  "name": "EVC BetMGM Tap (personal)",
  "version": "0.1.0",
  "description": "Personal use only. Copies the odds JSON that BetMGM pages you have open already receive, and sends it to your local EVC scanner. Sends no requests to BetMGM.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.pa.betmgm.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.pa.betmgm.com/*"],
      "js": ["tap_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.pa.betmgm.com/*"],
      "js": ["tap_relay.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "EVC BetMGM Tap" }
}
